[Unit]
Description=CommunityBot - bot de moderacao e diversao
# NAO use After/Wants=network-online.target aqui: esse target so existe no
# systemd de SISTEMA. No gerenciador de usuario ele nao existe, entao as duas
# diretivas viravam no-op silencioso - o bot subia com a rede ainda no ar e o
# primeiro contato com discord.com falhava com "Resource temporarily
# unavailable". O gate de DNS abaixo e o substituto que de fato funciona.

[Service]
Type=simple

# Espera o DNS resolver antes de subir, no maximo 60s. O prefixo "-" faz o
# systemd ignorar o codigo de saida: se estourar o tempo, o bot sobe assim
# mesmo e o retry do DisCatSharp assume.
ExecStartPre=-/usr/bin/timeout 60 /usr/bin/bash -c 'until getent ahostsv4 discord.com >/dev/null 2>&1; do sleep 1; done'

# O bot resolve config/ e data/ a partir do diretorio do EXECUTAVEL
# (AppContext.BaseDirectory), nao do cwd - entao esta linha nao e mais o que
# faz o config ser encontrado. Fica porque um cwd previsivel ainda ajuda em
# caminhos relativos que apareçam em log e em core dump.
#
# Consequencia pratica: trocar Debug<->Release, ou o TFM (net9.0 -> net10.0),
# no ExecStart troca junto o diretorio de estado. O data/ precisa ser movido a
# mao na troca, senao o bot sobe com tickets e guild-settings zerados.
WorkingDirectory=/home/daeese/daeesewrkspc/community-discord-bot/CommunityBot
# Release, nao Debug: Debug sai sem otimizacao e com as assercoes ligadas.
# Publicar com `dotnet publish -c Release -o bin/Release/net10.0` antes do
# primeiro start (ver README).
ExecStart=/home/daeese/daeesewrkspc/community-discord-bot/CommunityBot/bin/Release/net10.0/CommunityBot

# O IPv6 de saida desta maquina nao funciona; sem isto o .NET perde tempo em
# timeouts ao falar com a API do Discord. Mesmo motivo do ccore-bot.service.
Environment=DOTNET_SYSTEM_NET_DISABLEIPV6=1
Environment=DOTNET_ENVIRONMENT=Production

Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30

# Endurecimento minimo. E uma unit --user, entao o raio de acao ja e a conta do
# usuario - mas e nessa conta que mora o token, e o processo nao tem motivo
# nenhum para ganhar privilegio novo ou enxergar /tmp de mais ninguem.
#
# ProtectHome e ProtectSystem=strict ficam de FORA de proposito: o binario, o
# config e o data/ vivem todos dentro de $HOME, e ligar qualquer um dos dois
# impede o bot de subir.
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
