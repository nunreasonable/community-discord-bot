[Unit]
Description=CommunityBot - bot de moderacao e diversao
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# O bot resolve config/ e data/ a partir do diretorio do EXECUTAVEL
# (AppContext.BaseDirectory), nao do cwd - entao esta linha nao e mais o que
# faz o config ser encontrado. Fica porque um cwd previsivel ainda ajuda em
# caminhos relativos que apareçam em log e em core dump.
WorkingDirectory=/home/daeese/daeesewrkspc/community-discord-bot/CommunityBot
# Release, nao Debug: Debug sai sem otimizacao e com as assercoes ligadas.
# Publicar com `dotnet publish -c Release -o bin/Release/net9.0` antes do
# primeiro start (ver README).
ExecStart=/home/daeese/daeesewrkspc/community-discord-bot/CommunityBot/bin/Release/net9.0/CommunityBot

# O IPv6 de saida desta maquina nao funciona; sem isto o .NET perde tempo em
# timeouts ao falar com a API do Discord. Mesmo motivo do ccore-bot.service.
Environment=DOTNET_SYSTEM_NET_DISABLEIPV6=1
Environment=DOTNET_ENVIRONMENT=Production

Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30

# Endurecimento minimo. E uma unit --user, entao o raio de acao ja e a conta do
# usuario - mas e nessa conta que mora o token, e o processo nao tem motivo
# nenhum para ganhar privilegio novo ou enxergar /tmp de mais ninguem.
#
# ProtectHome e ProtectSystem=strict ficam de FORA de proposito: o binario, o
# config e o data/ vivem todos dentro de $HOME, e ligar qualquer um dos dois
# impede o bot de subir.
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
