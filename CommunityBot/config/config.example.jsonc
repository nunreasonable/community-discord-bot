{
    // Token da aplicacao do bot. Copie este arquivo para config.jsonc e cole o
    // token la - config.jsonc esta no .gitignore justamente por causa disto.
    "token": "",

    // ATALHO DE DESENVOLVIMENTO. Vazio - o normal - registra os comandos
    // GLOBALMENTE, e o Discord os anexa a todo servidor onde o bot for
    // instalado com o escopo applications.commands, inclusive os que ele entrar
    // depois. Nao ha nada a fazer por servidor.
    //
    // Preencher inverte isso: os comandos passam a existir SO nesses servidores
    // (aparecem na hora, o que ajuda a iterar) e o bot fica sem comando em todo
    // o resto - servidor novo inclusive. Voltar para global exige uma subida com
    // a lista vazia, que e quando o bot recolhe as copias por servidor; sem isso
    // elas se somam as globais e cada comando aparece duas vezes.
    "guildIds": []

    // O RESTO DA CONFIGURACAO NAO MORA MAIS AQUI.
    //
    // Canal de log de moderacao, canal-armadilha do softban automatico e os tres
    // ajustes de ticket agora sao POR SERVIDOR, e quem os define e quem tem
    // Gerenciar Servidor, pelo comando /config - sem precisar de acesso a esta
    // maquina. Use /config ver para ver como esta.
    //
    // Se voce ja tinha as chaves antigas preenchidas aqui, o bot as move sozinho
    // para o novo formato na primeira subida.
}
