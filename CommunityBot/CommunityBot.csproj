<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CommunityBot</RootNamespace>
    <AssemblyName>CommunityBot</AssemblyName>
  </PropertyGroup>

  <!--
    O bot resolve config/ e data/ a partir de AppContext.BaseDirectory, entao o
    config precisa existir AO LADO do executavel. Sem esta copia o binario em
    bin/ nao acharia o arquivo nenhum.

    config.jsonc entra com Condition: ele esta no .gitignore e pode nao existir
    numa maquina recem-clonada, e um Include sem condicao faria o build falhar
    com "item nao encontrado" antes mesmo da mensagem amigavel do Program.Main.

    PreserveNewest, e nao Always: editar o config e recarregado em runtime pelo
    carimbo de modificacao, e sobrescrever a copia a cada build apagaria uma
    edicao feita direto em bin/.
  -->
  <!--
    Nightly fixada, e nao a 10.7.0 estavel: desde marco de 2026 o Discord so
    aceita voz com DAVE (E2EE), e o DAVE da 10.7.0 e experimental. O ciclo de
    vida dele - quem entra ou sai do canal no meio da musica - so foi corrigido
    no PR #882, que saiu nas nightlies 10.7.1. Os pacotes DisCatSharp.* precisam
    estar TODOS na mesma versao; por isso ela mora numa propriedade so. Voltar
    para a estavel quando sair a 10.7.1.
  -->
  <PropertyGroup>
    <DisCatSharpVersion>10.7.1-nightly-032</DisCatSharpVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="config\config.example.jsonc" CopyToOutputDirectory="PreserveNewest" Link="config\config.example.jsonc" />
    <None Include="config\config.jsonc" CopyToOutputDirectory="PreserveNewest" Link="config\config.jsonc" Condition="Exists('config\config.jsonc')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DisCatSharp" Version="$(DisCatSharpVersion)" />
    <PackageReference Include="DisCatSharp.ApplicationCommands" Version="$(DisCatSharpVersion)" />
    <PackageReference Include="DisCatSharp.Interactivity" Version="$(DisCatSharpVersion)" />
    <PackageReference Include="DisCatSharp.Voice" Version="$(DisCatSharpVersion)" />
    <!--
      As bibliotecas nativas da voz: libopus, libsodium e libdave. O Fedora so
      instala libopus.so.0 e libsodium.so.26 - e o carregador do .NET procura o
      nome sem versao, que so vem nos pacotes -devel -, e a libdave nem existe
      empacotada. Sem ela o DAVE desliga em silencio e o Discord recusa a
      conexao de voz com o codigo 4017. O pacote Voice NAO puxa este sozinho,
      ao contrario do que a doc diz.
    -->
    <PackageReference Include="DisCatSharp.Voice.Natives" Version="$(DisCatSharpVersion)">
      <IncludeAssets>runtime; native; contentfiles</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!--
    DV2001: o DisCatSharp arrasta o Microsoft.DependencyValidation.Analyzers, que
    so serve para diagramas de validacao do Visual Studio. Nao ha nenhum aqui.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);DV2001</NoWarn>
  </PropertyGroup>

</Project>
