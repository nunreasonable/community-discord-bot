[Unit]
Description=Rich Presence pessoal do daeese (aplicacao Sollarety)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# O script resolve presence.json a partir do proprio diretorio, entao o cwd
# nao e critico - mas fixa-lo evita surpresa se isso mudar.
WorkingDirectory=/home/daeese/daeesewrkspc/community-discord-bot/presence
ExecStart=/usr/bin/python3 /home/daeese/daeesewrkspc/community-discord-bot/presence/daeese_presence.py

# Diferente do community-bot.service, quase nada aqui e rede: o processo fala
# com o socket IPC local do cliente Discord e, no maximo uma vez a cada 6 h por
# repositorio, com api.github.com (so para saber se o repo e publico). Esse
# host so tem IPv4, entao o IPv6 quebrado desta maquina nao atrasa nada e nao
# ha Environment de IPv6. O script tambem chama virsh/git/osinfo-query, todos
# com timeout.

# Restart=always, e nao on-failure: sair com codigo 0 porque o Discord estava
# fechado e o caso comum, nao uma falha. O proprio script ja faz backoff
# interno; este Restart e a rede de seguranca para o processo morrer de vez.
Restart=always
RestartSec=15
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
